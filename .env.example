# Any OpenAI-compatible endpoint. Default: Nebius Token Factory.
TUTOR_API_BASE=https://api.tokenfactory.nebius.com/v1
TUTOR_API_KEY=
# Signs session state so learners cannot edit their progress. 32+ random characters.
TUTOR_STATE_SECRET=
# Optional model overrides (Token Factory ids shown are the defaults).
# TUTOR_MODEL_TUTOR=nvidia/Nemotron-3-Ultra-550b-a55b
# TUTOR_MODEL_MARKER=nvidia/Nemotron-3.5-Super-VL
# TUTOR_MODEL_CHECKER=nvidia/Nemotron-3.5-Super-VL
# TUTOR_MODEL_SAFETY=nvidia/Nemotron-3_5-Lightning
# TUTOR_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# TUTOR_MODEL_REPORT=nvidia/Nemotron-3.5-Super-VL
# TUTOR_MODEL_EXPLORE=nvidia/Nemotron-3.5-Super-VL
# Optional: "Where you'll see this" cards after a question is finished (Tavily search). Off without a key.
# TAVILY_API_KEY=
# Optional: turns per client address per 10 minutes (default 40); TUTOR_DISABLED=1 switches the API off.
# TUTOR_TURNS_PER_10_MIN=40
# TUTOR_TURNS_PER_DAY=2000
# TUTOR_DISABLED=
# Optional: the tutor's own voice in talk mode, Murf (Julia) or Cartesia Sonic (Jacqueline).
# Without these the phone's voice is used.
# TUTOR_VOICE=murf                # or cartesia
# MURF_API_KEY=
# MURF_VOICE_ID=en-US-julia
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# TUTOR_VOICE_CHARS_PER_DAY=700   # characters per day before the phone voice takes over
